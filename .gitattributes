# Normalise line endings in the repository; check out native per platform.
* text=auto

# Windows batch/PowerShell must keep CRLF to run correctly.
*.bat text eol=crlf
*.ps1 text eol=crlf
*.nsi text eol=crlf

# C/C++/Python/Markdown stay LF in the repository.
*.cpp text eol=lf
*.h   text eol=lf
*.py  text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Binary formats - never touch.
*.png binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
*.svd binary
