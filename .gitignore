# ---- build outputs -------------------------------------------------------
build/
build-debug/
deploy/
dist/
out-render/
*.exe
*.dll
*.a
*.o
*.obj
*.ilk
*.pdb

# ---- generated / intermediate -------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json
build.ninja
.ninja_deps
.ninja_log
compile_commands.json
moc_*.cpp
qrc_*.cpp
ui_*.h
*_autogen/

# ---- vendor SVD packs (fetched by scripts/fetch-n32-svds.py) --------------
# Binary vendor assets: run the script once per machine instead of committing.
svd/
data/datasheets/

# ---- vendored tools (fetched by scripts/fetch-probe-rs.ps1) --------------
tools/

# ---- runtime output ------------------------------------------------------
out/
out-*/
out*/
*.log
*.pid

# ---- agent / editor / local state ---------------------------------------
.codegraph/
.reasonix/
.tmpocr/
.idea/
# .vscode/ is committed on purpose (shared build/debug config, see README §10).
# Only machine-specific files stay out of git:
.vscode/*.local.json
.vscode/ipch/
.vscode/*.code-workspace
.cache/
__pycache__/
*.pyc

# ---- secrets ------------------------------------------------------------
# .env holds the assistant/API keys used while developing; never commit it.
.env
.env.*
!.env.example
*.key

# ---- OS ------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
